{
  "openrouter": {
    "name": "OpenRouter",
    "format": "openai",
    "baseUrl": "https://openrouter.ai/api/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "headers": {
      "HTTP-Referer": "https://flintagent.dev",
      "X-OpenRouter-Title": "Flint Agent",
      "X-OpenRouter-Categories": "cli-agent,personal-agent"
    },
    "defaultModel": "google/gemini-2.5-flash",
    "balanceEndpoint": "/credits"
  },
  "openai": {
    "name": "OpenAI",
    "format": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "gpt-4o"
  },
  "anthropic": {
    "name": "Anthropic",
    "format": "anthropic",
    "baseUrl": "https://api.anthropic.com/v1",
    "authType": "x-api-key",
    "keyRequired": true,
    "headers": {
      "anthropic-version": "2023-06-01"
    },
    "defaultModel": "claude-sonnet-4-6",
    "modelsEndpoint": "/models?limit=100"
  },
  "groq": {
    "name": "Groq",
    "format": "openai",
    "baseUrl": "https://api.groq.com/openai/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "llama-3.3-70b-versatile"
  },
  "together": {
    "name": "Together",
    "format": "openai",
    "baseUrl": "https://api.together.xyz/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "meta-llama/Llama-3.3-70B-Instruct-Turbo"
  },
  "ollama": {
    "name": "Ollama (local)",
    "format": "openai",
    "baseUrl": "http://localhost:11434",
    "authType": "none",
    "modelsEndpoint": "/api/tags",
    "keyRequired": false,
    "defaultModel": "llama3.2",
    "ollamaCompat": true
  },
  "nvidia": {
    "name": "NVIDIA",
    "format": "openai",
    "baseUrl": "https://integrate.api.nvidia.com/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "z-ai/glm-5.3"
  },
  "cerebras": {
    "name": "Cerebras",
    "format": "openai",
    "baseUrl": "https://api.cerebras.ai/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "gpt-oss-120b"
  },
  "mistral": {
    "name": "Mistral",
    "format": "openai",
    "baseUrl": "https://api.mistral.ai/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "mistral-small-latest"
  },
  "deepinfra": {
    "name": "DeepInfra",
    "format": "openai",
    "baseUrl": "https://api.deepinfra.com/v1/openai",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "openai/gpt-oss-120b"
  },
  "fireworks": {
    "name": "Fireworks",
    "format": "openai",
    "baseUrl": "https://api.fireworks.ai/inference/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "accounts/fireworks/models/gpt-oss-120b"
  },
  "huggingface": {
    "name": "Hugging Face",
    "format": "openai",
    "baseUrl": "https://router.huggingface.co/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "openai/gpt-oss-120b"
  },
  "sambanova": {
    "name": "SambaNova",
    "format": "openai",
    "baseUrl": "https://api.sambanova.ai/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "gpt-oss-120b"
  },
  "novita": {
    "name": "Novita",
    "format": "openai",
    "baseUrl": "https://api.novita.ai/openai",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "zai-org/glm-5.3-flash"
  },
  "nebius": {
    "name": "Nebius",
    "format": "openai",
    "baseUrl": "https://api.studio.nebius.com/v1",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "openai/gpt-oss-120b"
  },
  "gemini": {
    "name": "Gemini (OpenAI-compat)",
    "format": "openai",
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
    "authType": "bearer",
    "modelsEndpoint": "/models",
    "keyRequired": true,
    "defaultModel": "gemini-3-flash-preview"
  }
}
