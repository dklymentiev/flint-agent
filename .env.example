# Flint Agent — Environment Variables
# Copy to .env and fill in your values

# Provider API keys (at least one required)
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Provider and model (optional — set via first-run wizard or /model command)
# FLINT_PROVIDER=openrouter
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OpenRouter hosts for the main model (provider slugs from the model's endpoints
# page). Unset = OpenRouter picks, and hosts differ in price and in answers.
# OPENROUTER_PROVIDER_ONLY=xiaomi,atlas-cloud
# OPENROUTER_PROVIDER_IGNORE=digitalocean
# OPENROUTER_PROVIDER_ORDER=
# OPENROUTER_PROVIDER_SORT=price    # price | throughput | latency

# Classifier model — REQUIRED, no fallback. Runs before every user turn
# and picks the tools the agent sees. Measured 2026-04-21 on 4 MCP-routing
# tasks (docs / planner / mesh / browser):
#   openai/gpt-5.4-mini          4/4  1.5-2s   $0.75/M   best value, recommended
#   x-ai/grok-4.20               4/4  1.0-1.3s $2/M      fastest
#   anthropic/claude-sonnet-4.6  4/4  2.5-3s   $3/M      also works
#   qwen/qwen3.5-flash-02-23     4/4  4-15s    $0.07/M   cheapest but too slow for classifier
# Known-bad:
#   openai/gpt-5.4-nano          1/4  — picks "no tools" when tools ARE needed
#   google/gemini-2.0-flash-001  2.5/4 — prev default, misses MCP routing
#   nvidia/nemotron-3-super      0/4  — returns plain text instead of JSON
INTENT_MODEL=openai/gpt-5.4-mini

# Agent limits
# AGENT_MAX_ITERATIONS=150         # Max tool-call iterations per message
# AGENT_MAX_COST=0                 # Max cost per message ($, 0=unlimited)
# AGENT_AUTO_MAX_ITERATIONS=50     # Max iterations in /auto mode
# AGENT_AUTO_MAX_COST=0.50         # Max cost in /auto mode ($)
# AGENT_MAX_RESPONSE_TOKENS=16384  # Max response tokens per API call
# AGENT_MAX_RESPONSE_LINES=500     # Max lines per response
# AGENT_MAX_CHILDREN=5             # Max concurrent child agents
# AGENT_MAX_BATCH_FILES=20         # Max files per batch operation
# AGENT_MAX_LINES=5000             # Max lines per file read

# Filesystem sandbox
# AGENT_ALLOWED_PATHS=/home/user/project,/tmp   # Comma-separated allowed dirs (empty=unrestricted)
# AGENT_DENIED_PATHS=/etc,/root                 # Comma-separated denied dirs
# AGENT_WORKDIR=                                # Working directory override

# MCP servers (format: name|transport|url, comma-separated)
# transport: sse, http, or stdio
# MCP_SERVERS=mesh|sse|http://localhost:8200/sse,memory|stdio|~/agent-memory/agent-memory mcp

# Screenbox (virtual desktop)
# SCREENBOX_URL=http://localhost:8080

# Security
# AGENT_SECURITY_POLICY=normal                  # normal, strict, permissive
# AGENT_SECURITY_DISABLE=false                  # Disable all security (NOT recommended)
# AGENT_CONTENT_GATE_BLOCK_INJECTIONS=true      # Block detected prompt injections
# AGENT_MEMORY_HMAC_KEY=                        # HMAC key for memory integrity (auto-generated if empty)
# AGENT_PAIRING_SECRET=                         # Secret for agent pairing protocol

# Server
# AGENT_PORT=3000                  # HTTP API port
# FLINT_PAIRING_TTL_HOURS=24       # How long a paired program stays let in (hours, 0 = does not expire)
# AGENT_PARENT_PORT=               # Parent agent port (child agents only)
# AGENT_DEPTH=0                    # Agent nesting depth (0=root, auto-set for children)

# Sessions & logging
# AGENT_SESSION_RETENTION_DAYS=30  # Auto-delete sessions older than N days
# AGENT_LOG_LEVEL=info             # debug, info, warn, error
# AGENT_LOG_RETENTION_DAYS=7       # Auto-delete logs older than N days
# AGENT_CLEANUP_INTERVAL_MIN=60    # Log cleanup interval in minutes

# Timeouts
# AGENT_IDLE_TIMEOUT=0             # Auto-exit after N seconds idle (0=disabled)
# AGENT_CHILD_IDLE_TIMEOUT=0       # Child agent idle timeout (seconds, 0 = lives as long as the parent)
# AGENT_CHILD_CLEANUP_DELAY=5000   # Delay before cleaning up dead children (ms)

# Context management
# COMPRESS_AFTER_TOKENS=50000      # Compress context after N tokens
# AGENT_PROFILE=default            # Active profile name

# Intent detection
# INTENT_MODE=regex                # regex, ai, hybrid
# INTENT_MODEL=                    # Model for AI intent detection

# Budget
# AGENT_BUDGET_WARNINGS=true       # Show cost warnings

# Agent memory (external binary)
# AGENT_MEMORY_BIN=agent-memory    # Path to agent-memory binary

# Shell
# AGENT_SHELL=bash                 # Shell for run_command tool
# FLINT_ENV_DIR=~/.flint/env       # Flint's own venv + npm prefix, first on PATH for commands
# FLINT_OWN_ENV=1                  # 0 = commands run with the system python/npm only

# Self-verification: after "done" on a turn that changed files and ran nothing,
# one more round asks the model to show the change works. Off by default; turn it
# on for a weaker model that stops before checking its work.
# FLINT_SELF_VERIFY=on

# Plugins
# FLINT_PLUGIN_INSTALL=ask         # ask = install_plugin/reload_plugins always need approval,
#                                  # even for API callers (unattended runs are refused); allow = no asking
# FLINT_PLUGINS_DIR=~/.flint/plugins

# Memory (optional Mesh integration)
# MEMORY_API_URL=http://localhost:8200
